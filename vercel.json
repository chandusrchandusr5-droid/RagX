{
  "buildCommand": "cd ragx/frontend && npm install && npm run build",
  "outputDirectory": "ragx/frontend/dist",
  "routes": [
    {
      "src": "/api/documents",
      "dest": "/api/documents.py"
    },
    {
      "src": "/api/quality/(.*)",
      "dest": "/api/quality.py"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
