{
  "buildCommand": "cd ragx/frontend && npm install && npm run build",
  "outputDirectory": "ragx/frontend/dist",
  "rewrites": [
    {
      "source": "/api/documents",
      "destination": "/api/documents.js"
    },
    {
      "source": "/api/quality/audit",
      "destination": "/api/quality.js"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
