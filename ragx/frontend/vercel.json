{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/documents",
      "destination": "/api/documents.js"
    },
    {
      "source": "/api/quality/audit",
      "destination": "/api/quality.js"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
